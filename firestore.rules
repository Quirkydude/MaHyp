rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user owns the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Users collection - each user can only access their own data
    match /users/{userId} {
      allow read, write: if isOwner(userId);
      
      // Blood pressure readings subcollection
      match /bp_readings/{readingId} {
        allow read, write: if isOwner(userId);
      }
      
      // Medications subcollection
      match /medications/{medicationId} {
        allow read, write: if isOwner(userId);
      }
      
      // Medication logs subcollection
      match /medication_logs/{logId} {
        allow read, write: if isOwner(userId);
      }
    }
    
    // Default deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
